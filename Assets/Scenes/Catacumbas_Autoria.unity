      resolved: 1
    - room: 5
      concept: Art/Catacumbas/ReworkCompleto/Conceito-Vestibulos-v1.png
      comparison: Art/Catacumbas/ReworkCompleto/Comparacoes/R05.png
      comparisonHash: V7d7Iabl612X87z7eu7aGl36SJYPJUJR54qi4X6CZPY=
